@model CostEstimate.Models.Common.Class;

@{
    string _NickName = User.Claims.FirstOrDefault(s => s.Type == "NICKNAME")?.Value;
    string _Name = User.Claims.FirstOrDefault(s => s.Type == "Name")?.Value;
    string _SurName = User.Claims.FirstOrDefault(s => s.Type == "SurName")?.Value;
    string _Division = User.Claims.FirstOrDefault(s => s.Type == "Division")?.Value;
    string _Section = User.Claims.FirstOrDefault(s => s.Type == "Section")?.Value;
}

<link href="~/css/StyleQuatation.css" rel="stylesheet" />

<body class="estimation-page moldother-page">

    <div class="a4-page">

        <!-- =========================================================
             HEADER
        ========================================================== -->

        <div class="row" style="align-items:flex-start;">

            <div class="col-40 header-box">

                <table style="width:150px;">

                    <tr>
                        <td style="width:30%;" class="label-cell">
                            MAIL :
                        </td>

                        <td class="dept-cell">
                            SATELLITE
                        </td>
                    </tr>

                    <tr>
                        <td></td>

                        <td class="dept-cell">
                            ST
                        </td>
                    </tr>

                </table>

            </div>

            <div class="col-60"></div>

        </div>


        <br />


        <!-- =========================================================
             TITLE
        ========================================================== -->

        <div class="row" style="align-items:baseline;">

            <div class="col-60">

                <span class="doc-title">
                    ESTIMATION
                    <span class="sub">
                        in Manufacturing Cost.
                    </span>
                </span>

            </div>

            <div class="col-40 txt-right">

                <span class="issue-date-value">
                    DATE :
                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrIssueDate)
                </span>

            </div>

        </div>


        <!-- =========================================================
             REVISION
        ========================================================== -->

        <div class="row"
             style="align-items:flex-start; margin-top:2px;">

            @{
                var _revised = Model._ViewceMastMoldOtherRequest?.mrRevision > 0
                    ? "REVISED " + Model._ViewceMastMoldOtherRequest.mrRevision +" -"
                    : "";

                var _trevise = Model._ViewceMastMoldOtherRequest?.mrRevision > 0
                   ?  "-"+ Model._ViewceMastMoldOtherRequest.mrRevision
                    : "";
            }
            <div class="col-100">

                <span class="rev-tag" style="font-size:16px">
                    <span style="font-size:20px ;color:red">
                        @_revised
                    </span>
                    
                 
                    Ref.No.

                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrDocmentNo)

                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrEvent)

                </span>
                <br />
                <span class="rev-tag" style="font-size:13px">
                    Ref.Mold No :
                    @Html.DisplayFor(model => model._ViewceMastMoldOtherRequest.mrShippingType)
                    -
                    @Html.DisplayFor(model => model._ViewceMastMoldOtherRequest.mrIssueDate)
                    -
                    @Html.DisplayFor(model => model._ViewceMastMoldOtherRequest.mrMoldType)
                    -
                    @Html.DisplayFor(model => model._ViewceMastMoldOtherRequest.mrDocMold)
                    @_trevise
                </span>

            </div>


        </div>


        <hr class="title-divider" />


        <!-- =========================================================
             CUSTOMER / MODEL
        ========================================================== -->

        <div class="row" style="margin-top:10px;">

            <div class="col-30"></div>

            <div class="col-70 txt-right">

                <span class="customer-line">

                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrCustomerName)

                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrModelName)

                    (
                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrFunction)
                    )

                </span>

            </div>

        </div>


        <!-- =========================================================
             DOCUMENT NO / TYPE
        ========================================================== -->

        <div class="row"
             style="margin-top:10px; align-items:center;">

            <div class="col-20">

                <span class="ref-no">

                    @Html.DisplayFor(model =>
                        model._ViewceMastMoldOtherRequest.mrDocmentNo)

                </span>

            </div>

            <div class="col-50"></div>

            <div class="col-30"
                 style="text-align:center;">

                <span class="type-tag">
                    NEW MOLD
                </span>

            </div>

        </div>


        <hr class="section-rule" />


        <!-- =========================================================
             ITEM TABLE
        ========================================================== -->

        @{
            int loopCount = Model._ListViewceItemPartName.Count;
        }

        <div class="item-table">

            <!-- ================= HEADER ================= -->

            <div class="item-table-head">

                <div class="col-30 item-cell item-cell-head">
                    MOLD No. &amp; NAME
                </div>

                <div class="col-30 item-cell item-cell-head">
                    CAVITY &amp; AMOUNT BAHT
                </div>

                <div class="col-40 item-cell item-cell-head">
                    TYPE, GATE, SLIDE &amp; OTHER SPEC.
                </div>

            </div>


            <!-- ================= ITEMS ================= -->

            @for (int i = 0; i < loopCount; i++)
            {
                bool hasDetail =
                    i < Model._ListViewMoldOtherDatailQuotation.Count;

                string estimateCostRaw =
                    hasDetail
                    ? Model._ListViewMoldOtherDatailQuotation[i].dEstimateCost
                    : null;

                decimal estimateCost = 0;

                if (!string.IsNullOrWhiteSpace(estimateCostRaw))
                {
                    decimal.TryParse(
                        estimateCostRaw.Replace(",", ""),
                        out estimateCost
                    );
                }

                <div class="item-table-row">

                    <!-- ================= MOLD NAME ================= -->

                    <div class="col-30 item-cell item-cell-mold">

                        @Html.DisplayFor(x =>
                            x._ListViewceItemPartName[i].ipPartName)

                    </div>


                    <!-- ================= CAVITY / AMOUNT ================= -->

                    <div class="col-30 item-cell item-cell-cavity">

                        <div class="item-cavity-info">

                            @Html.DisplayFor(x =>
                                x._ListViewceItemPartName[i].ipCavityNo)

                            @Html.DisplayFor(x =>
                                x._ListViewceItemPartName[i].ipTypeCavity)

                        </div>


                        @if (hasDetail && estimateCost > 0)
                        {
                            <div class="item-cost-value">

                                @Html.DisplayFor(x =>
                                    x._ListViewMoldOtherDatailQuotation[i]
                                        .dEstimateCost)

                            </div>
                        }
                        else
                        {
                            <div class="item-cost-empty">
                                -
                            </div>
                        }

                    </div>


                    <!-- ================= SPECIFICATION ================= -->

                    <div class="col-40 item-cell item-cell-spec">

                        @if (hasDetail)
                        {
                            @Html.DisplayFor(x =>
                                x._ListViewMoldOtherDatailQuotation[i].dDetail)
                        }

                    </div>

                </div>
            }

        </div>


        <!-- =========================================================
             MAKING SCHEDULE
        ========================================================== -->

        <div class="row"
             style="margin-top:14px;">

            <div class="col-100">

                <span class="schedule-heading">
                    Making schedule
                </span>

                <br />

                <span class="info-value-note">
                    LEAD TIME
                </span>

            </div>

        </div>


        <!-- ================= SCHEDULE TABLE ================= -->

        <div class="schedule-table">

            <!-- DATE ROW -->

            <div class="schedule-row">

                <div class="schedule-cell">
                    (MON.)
                </div>

                <div class="schedule-cell">
                    @Html.DisplayFor(model =>
                        model.rMoldGO)
                </div>

                <div class="schedule-cell">
                    @Html.DisplayFor(model =>
                        model.rMoldTry1)
                </div>

                <div class="schedule-cell">
                    @Html.DisplayFor(model =>
                        model.rMoldMass1)
                </div>

                <div class="schedule-cell">
                    @Html.DisplayFor(model =>
                        model.rMoldMass)
                </div>

            </div>


            <!-- ITEM ROW -->

            <div class="schedule-row">

                <div class="schedule-cell schedule-cell-tall">
                    ITEM
                </div>

                <div class="schedule-cell schedule-cell-tall">
                    O<br />
                    DS
                </div>

                <div class="schedule-cell schedule-cell-tall">
                    T1
                </div>

                <div class="schedule-cell schedule-cell-tall">
                    SH
                </div>

                <div class="schedule-cell schedule-cell-tall">
                    MP
                </div>

            </div>

        </div>


        <!-- ================= SCHEDULE LEGEND ================= -->

        <div class="row center"
             style="margin-top:5px;">

            <span class="schedule-legend">

                O : P/O&nbsp;&nbsp;&nbsp;&nbsp;
                D : DRAW.&nbsp;&nbsp;&nbsp;&nbsp;
                S : START&nbsp;&nbsp;&nbsp;&nbsp;
                T1 : TRY-1&nbsp;&nbsp;&nbsp;&nbsp;
                T : TRY 2-3,…,&nbsp;&nbsp;&nbsp;&nbsp;
                PP : PRE-PRODUCTION&nbsp;&nbsp;&nbsp;&nbsp;
                MP : MASS-PRODUCTION&nbsp;&nbsp;&nbsp;&nbsp;
                FS : FIN. &amp; SHIP

            </span>

        </div>


        <!-- =========================================================
             SIGN-OFF
        ========================================================== -->

        <div class="row"
             style="margin-top:20px;">

            <div class="col-80"></div>

            <div class="col-20">

                <span class="signoff">
                    Yours faithfully,
                </span>

            </div>

        </div>


        <!-- =========================================================
             SIGNATURE : ISSUED BY
        ========================================================== -->

        <div class="row sig-block"
             style="align-items:flex-end;">

            <div class="col-20">

                <span class="sig-role">
                    ISSUED BY:
                </span>

            </div>

            <div class="col-50">

                <span class="sig-name">

                    @Html.DisplayFor(model =>
                        model._ViewOperaterCP.IssueBy)

                </span>

            </div>

            <div class="col-30 center sig-line">

                @{
                    var empOP = Model._ViewOperaterCP.empIssueBy;
                }

                <img src="~/images/@(empOP).png"
                     style="width:100px;height:20px;"
                     onerror="this.style.display='none';" />

            </div>

        </div>


        <!-- =========================================================
             SIGNATURE : CHECKED BY TL
        ========================================================== -->

        <div class="row sig-block"
             style="align-items:flex-end;">

            <div class="col-20">

                <span class="sig-role">
                    CHECKED BY:
                </span>

            </div>

            <div class="col-50">

                <span class="sig-name">

                    @Html.DisplayFor(model =>
                        model._ViewOperaterCP.CheckedByTL)

                </span>

            </div>

            <div class="col-30 center sig-line">

                @{
                    var empTL =
                        Model._ViewOperaterCP.empCheckedByTL;
                }

                <img src="~/images/@(empTL).png"
                     style="width:100px;height:20px;"
                     onerror="this.style.display='none';" />

            </div>

        </div>


        <!-- =========================================================
             SIGNATURE : CHECKED BY TM
        ========================================================== -->

        <div class="row sig-block"
             style="align-items:flex-end;">

            <div class="col-20">

                <span class="sig-role">
                    CHECKED BY:
                </span>

            </div>

            <div class="col-50">

                <span class="sig-name">

                    @Html.DisplayFor(model =>
                        model._ViewOperaterCP.CheckedByTM)

                </span>

            </div>

            <div class="col-30 center sig-line">

                @{
                    var empTM =
                        Model._ViewOperaterCP.empCheckedByTM;
                }

                <img src="~/images/@(empTM).png"
                     style="width:110px;height:30px;"
                     onerror="this.style.display='none';" />

            </div>

        </div>


        <!-- =========================================================
             SIGNATURE : APPROVED BY
        ========================================================== -->

        <div class="row sig-block"
             style="align-items:flex-end;">

            <div class="col-20">

                <span class="sig-role">
                    APPROVED BY:
                </span>

            </div>

            <div class="col-50">

                <span class="sig-name">

                    @Html.DisplayFor(model =>
                        model._ViewOperaterCP.ApproveBy)

                </span>

            </div>

            <div class="col-30 center sig-line">

                @{
                    var empAP =
                        Model._ViewOperaterCP.empApproveBy;
                }

                <img src="~/images/@(empAP).png"
                     style="width:100px;height:30px;"
                     onerror="this.style.display='none';" />

            </div>

        </div>

    </div>

</body>