        </td>
        <td colspan="3">
            <input class="form-control center" id="EsDPCostF" autocomplete="off" style="width:100%;height:80%;font-size:10px;background-color:lightgray" type="number" min="0" readonly />

        </td>
        <td colspan="3">
            <input class="form-control center" id="EsMECostG" autocomplete="off" style="width:100%;height:80%;font-size:10px;background-color:lightgray" type="number" min="0" readonly />
        </td>
    </tr>
    <tr>
        <td colspan="6">H = COST T0 - SH ((E+F+G)). </td>
