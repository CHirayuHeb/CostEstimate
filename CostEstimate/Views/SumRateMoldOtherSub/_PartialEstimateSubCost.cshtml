            <input class="form-control center" id="EssumEFG" autocomplete="off" style="width:100%;height:80%;font-size:10px;background-color:lightgray" type="text" readonly />

        </td>
        <td>
            .KB
        </td>
    </tr>
</table>
<table class="tbgreen " >

