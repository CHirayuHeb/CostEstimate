@model CostEstimate.Models.Common.Class;
@{
    //string _Permission = User.Claims.FirstOrDefault(s => s.Type == "Permission").Value;
    string _NickName = User.Claims.FirstOrDefault(s => s.Type == "NICKNAME")?.Value;
    string _Name = User.Claims.FirstOrDefault(s => s.Type == "Name")?.Value;
    string _SurName = User.Claims.FirstOrDefault(s => s.Type == "SurName")?.Value;
    string _Division = User.Claims.FirstOrDefault(s => s.Type == "Division")?.Value;
    string _Section = User.Claims.FirstOrDefault(s => s.Type == "Section")?.Value;

}
@*<link href="~/css/Home/siteHome.css" rel="stylesheet" />
<link href="~/css/New/pageQuotation.css" rel="stylesheet" />*@
<link href="~/css/StyleQuatation.css" rel="stylesheet" />
<body class="estimation-page">
    <div class="a4-page">
        <!-- ===================== Header ===================== -->
        <div class="row" style="align-items:flex-start;">
            <div class="col-30 header-box">
                <table style="width:100%;">
                    <tr>
                        <td style="width:20%;" class="label-cell">MAIL :</td>
                        <td class="dept-cell">Purchasing</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td class="dept-cell">PU</td>
                    </tr>
                </table>
            </div>
            <div class="col-60"></div>
            <div class="col-10">
                <div class="circle">
                    <div class="content">1/1</div>
                </div>
            </div>
        </div>
        <br />
        <!-- ===================== Title ===================== -->
        <div class="row" style="align-items:baseline;">
            <div class="col-60">
                <span class="doc-title">
                    ESTIMATION
                    <span class="sub">in Manufacturing Cost.</span>
                </span>
            </div>
            <div class="col-40"></div>
        </div>
        <div class="row" style="align-items:flex-start; margin-top:2px;">
            <div class="col-60"></div>
            <div class="col-40 issue-date-block">
                <span style="font-size:11px; color:#555;">ISSUE DATE :</span>
                <span class="issue-date-value">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smIssueDate)</span>
            </div>
        </div>
        <hr class="title-divider" />
        <!-- ===================== Lot/Order / Customer ===================== -->
        <div class="row" style="align-items:center;">
            <div class="col-50">
                <span class="ce-no">
                    Lot No. &amp; Order No.
                    @Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smLotNo)
                    - @Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smOrderNo)
                    - REV @Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smRevision)
                </span>
            </div>
            <div class="col-50 txt-right">
                <span class="customer-line">
                    @Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smCustomerName)
                    @Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smModelName)
                    (@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smFunction))
                </span>
            </div>
        </div>
        <div class="row" style="margin-top:5px; align-items:center;">
            <div class="col-30">
                <span class="doc-no">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smDocumentNo)</span>
            </div>
            <div class="col-30"></div>
            <div class="col-40 txt-right">
                <span class="type-tag">SUB MAKER REQUEST SHEET.</span>
            </div>
        </div>
        <hr class="section-rule" />
   
        <!-- ===================== Mold info panel ===================== -->
        <div class="info-panel">
            <div class="row" style="margin-bottom:5px; align-items:center;">
                <div class="col-25">
                    <span class="info-label">Mold No. &amp; Name :</span>
                </div>
                <div class="col-60" style="text-align:center;">
                   
                    @{
                        var vIcs = Model._ViewceMastSubMakerRequest.smIcsName;
                        var vMoldName = Model._ViewceMastSubMakerRequest.smMoldName;
                        var vMold = "";
                        var vFullText = "";

                        if (string.IsNullOrEmpty(vIcs))
                        {
                            vMold = vMoldName;
                            vFullText = vMoldName;
                        }
                        else
                        {
                            vMold = vIcs + "<br> (" + vMoldName + ")";
                            vFullText = vIcs + " (" + vMoldName + ")";
                        }
                    }
                    <span class="info-value-mold" title="@vFullText">@Html.Raw(vMold)</span>
                </div>
                <div class="col-15"></div>
            </div>
            <div class="row" style="margin-bottom:12px; align-items:center;">
                <div class="col-25">
                    <span class="info-label">Numbers of cavity :</span>
                </div>
                <div class="col-45 center">
                    <span class="info-value">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smCavityNo)</span>
                </div>
                <div class="col-30">
                    <span class="info-value-note">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smTypeCavity)</span>
                </div>
            </div>
            <div class="row" style="align-items:center;">
                <div class="col-25">
                    <span class="info-label">IN-HOUSE COST :</span>
                </div>
                <div class="col-45 center">
                    @{
                        var vIN_HOUSE = @Model._ViewceMastSubMakerRequest.smRoundUp * 1000;
                    }
                    <span class="amount-value">@vIN_HOUSE.ToString("#,##0.##")</span>
                </div>
                <div class="col-30">
                    <span class="amount-unit">BAHT.</span>
                </div>
            </div>
        </div>
        <!-- ===================== Modification detail ===================== -->
        <div class="row" style="margin-bottom:6px;">
            <div class="col-60">
                <span class="section-heading">Item of Modification &amp; Contents</span>
            </div>
            <div class="col-40"></div>
        </div>
        <div style="margin-bottom:14px;" class="info-panel">
            <div class="row">
                <div class="col-50">
                    <span class="mod-item-title">1.) According to your request MAIL BY MOLD</span>
                </div>
                <div class="col-50 txt-right">
                    @{
                        var weight = @Model._ViewceMastSubMakerRequest.smWeight is null
                                     || @Model._ViewceMastSubMakerRequest.smWeight == "" ? "0" : @Model._ViewceMastSubMakerRequest.smWeight;
                    }
                    <span class="mod-meta">WEIGHT = @weight KG.</span>
                    <span class="mod-meta">QTY. @Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smQty) PC.</span>
                </div>
            </div>
            <div class="row" style="margin-top:6px;">
                <div class="col-5"></div>
                <div class="col-90 mod-detail-box">
                    @Html.TextAreaFor(model => model._ViewceMastSubMakerRequest.smDetail, new
               {
                   @class = "font-Arial",
                   rows = 11,
                   @readonly = "readonly",
                   style = "border: none; resize: none; background: transparent; width: 100%; font-size:12px; padding: 4px 2px;"
               })
                </div>
                <div class="col-5"></div>
            </div>
        </div>
        <!-- ===================== Schedule ===================== -->
        <div style="margin-bottom:10px;">
            <span class="schedule-heading">Making schedule</span>
            <div class="sched-panel info-panel">
                <div class="row" style="align-items:center; margin-bottom:8px;">
                    <div class="col-10"></div>
                    <div class="col-30">
                        <span class="sched-label">MATERIAL OUT. / DATE.</span>
                    </div>
                    <div class="col-20">
                        <span class="sched-value">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smMatOutDate)</span>
                    </div>
                    <div class="col-20">
                        <span class="sched-time-label">TIME</span>
                    </div>
                    <div class="col-20">
                        <span class="sched-value">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smMatOutTime)</span>
                    </div>
                </div>
                <div class="row" style="align-items:center;">
                    <div class="col-10"></div>
                    <div class="col-30">
                        <span class="sched-label">DELIVERY. / DATE</span>
                    </div>
                    <div class="col-20">
                        <span class="sched-value">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smDeliveryDate)</span>
                    </div>
                    <div class="col-20">
                        <span class="sched-time-label">TIME</span>
                    </div>
                    <div class="col-20">
                        <span class="sched-value">@Html.DisplayFor(model => model._ViewceMastSubMakerRequest.smDeliveryTime)</span>
                    </div>
                </div>
            </div>
            <hr class="section-rule" />
            <div class="row" style="margin-top:14px;">
                <div class="col-80"></div>
                <div class="col-20" style="margin-top:4px; margin-bottom:10px;">
                    <span class="signoff">Yours faithfully,</span>
                </div>
            </div>
            <br />
            <!-- ===================== Signatures ===================== -->
            <div class="row sig-block" style="align-items:flex-end;">
                <div class="col-20"><span class="sig-role">ISSUED BY:</span></div>
                <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.IssueBy)</span></div>
                <div class="col-30 center sig-line">
                    @{
                        var empCP = Model._ViewOperaterCP.empIssueBy;
                    }
                    <img src="~/images/@(empCP).png" style="width:100px;height:25px;" onerror="this.style.display='none';" />
                </div>
            </div>
            <div class="row sig-block" style="align-items:flex-end;">
                <div class="col-20"><span class="sig-role">CHECKED BY:</span></div>
                <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.CheckedByTL)</span></div>
                <div class="col-30 center sig-line">
                    @{
                        var empTL = Model._ViewOperaterCP.empCheckedByTL;
                    }
                    <img src="~/images/@(empTL).png" style="width:100px;height:25px;" onerror="this.style.display='none';" />
                </div>
            </div>
            <div class="row sig-block" style="align-items:flex-end;">
                <div class="col-20"><span class="sig-role">CHECKED BY:</span></div>
                <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.CheckedByTM)</span></div>
                <div class="col-30 center sig-line">
                    @{
                        var empTM = Model._ViewOperaterCP.empCheckedByTM;
                    }
                    <img src="~/images/@(empTM).png" style="width:100px;height:25px;" onerror="this.style.display='none';" />
                </div>
            </div>
            <div class="row sig-block" style="align-items:flex-end;">
                <div class="col-20"><span class="sig-role">APPROVED BY:</span></div>
                <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.ApproveBy)</span></div>
                <div class="col-30 center sig-line">
                    @{
                        var empAP = Model._ViewOperaterCP.empApproveBy;
                    }
                    <img src="~/images/@(empAP).png" style="width:100px;height:20px;" onerror="this.style.display='none';" />
                </div>
            </div>
        </div>
    </div>
</body>


