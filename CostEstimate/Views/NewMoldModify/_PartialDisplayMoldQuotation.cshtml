@model CostEstimate.Models.Common.Class;
@{
    string _NickName = User.Claims.FirstOrDefault(s => s.Type == "NICKNAME")?.Value;
    string _Name = User.Claims.FirstOrDefault(s => s.Type == "Name")?.Value;
    string _SurName = User.Claims.FirstOrDefault(s => s.Type == "SurName")?.Value;
    string _Division = User.Claims.FirstOrDefault(s => s.Type == "Division")?.Value;
    string _Section = User.Claims.FirstOrDefault(s => s.Type == "Section")?.Value;
}
<link href="~/css/StyleQuatation.css" rel="stylesheet" />
<body class="estimation-page">
    <div class="a4-page">
        <!-- ===================== Title ===================== -->
        <div class="row" style="align-items:baseline;">
            <div class="col-60">
                <span class="doc-title">
                    ESTIMATION
                    <span class="sub">in Manufacturing Cost.</span>
                </span>
            </div>
            <div class="col-40 txt-right">
                <span class="issue-date-value">ISSUE DATE : @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfIssueDate)</span>
            </div>
        </div>
        <div class="row" style="align-items:flex-start; margin-top:2px;">
            <div class="col-60">
                <span class="rev-tag">
                    REV. @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfRevision)
                </span>
            </div>
            <div class="col-40 txt-right">
                <span class="quote-note">Quotation valid for 30 days</span>
            </div>
        </div>
        <hr class="title-divider" />
        <!-- ===================== Ref / Customer ===================== -->
        <div class="row" style="align-items:center;">
            <div class="col-30">
                <span class="ce-no">CE No : @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfCENo)</span>
            </div>
            <div class="col-70 txt-right">
                <span class="customer-line">
                    @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfCustomerName)
                    @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfModelName)
                    (@Html.DisplayFor(model => model._ViewceMastModifyRequest.mfFunction))
                </span>
            </div>
        </div>
        <div class="row" style="margin-top:10px; align-items:center;">
            <div class="col-30">
                <span class="ref-no">Ref.No. @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfRefNo)</span>
            </div>
            <div class="col-30"></div>
            <div class="col-40" style="text-align:center;">
                <span class="type-tag">
                    @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfType)
                </span>
            </div>
        </div>
        <hr class="section-rule" />
        <br />
        <!-- ===================== Mold info panel ===================== -->
        <div class="info-panel">
            <div class="row" style="margin-bottom:12px; align-items:center;">
                <div class="col-25">
                    <span class="info-label">Mold No. &amp; Name :</span>
                </div>
                <div class="col-55" style="text-align:center;">
                    @{
                        var vMoldName = Model._ViewceMastModifyRequest.mfMoldNoOrMoldName;
                        var vMold = "";

                        if (Model._ViewceMastModifyRequest.mfIcsname == null || Model._ViewceMastModifyRequest.mfIcsname == "")
                        {
                            vMold = vMoldName;
                        }
                        else
                        {
                            vMold = Model._ViewceMastModifyRequest.mfIcsname + "<br> (" + Model._ViewceMastModifyRequest.mfMoldNoOrMoldName + ")";
                        }
                    }
                    <span class="info-value-mold">@Html.Raw(vMold)</span>
                </div>
                <div class="col-20"></div>
            </div>
            <div class="row" style="margin-bottom:12px; align-items:center;">
                <div class="col-25">
                    <span class="info-label">Numbers of cavity :</span>
                </div>
                <div class="col-50 center">
                    <span class="info-value">@Html.DisplayFor(model => model._ViewceMastModifyRequest.mfCavityNo)</span>
                </div>
                <div class="col-25">
                    <span class="info-value-note">@Html.DisplayFor(model => model._ViewceMastModifyRequest.mfTypeCavity)</span>
                </div>
            </div>
            <div class="row" style="align-items:center;">
                <div class="col-25">
                    <span class="info-label">Amount &amp; quantity :</span>
                </div>
                <div class="col-50 center">
                    @{
                        var vAmount = @Model._ViewceMastModifyRequest.mfRoundupotalESTCost;
                    }
                    <span class="amount-value">@vAmount.ToString("#,##0.##")</span>
                </div>
                <div class="col-25">
                    <span class="amount-unit">BAHT.</span>
                </div>
            </div>
        </div>
        <!-- ===================== Modification detail ===================== -->
        <div class="row" style="margin-bottom:6px;">
            <div class="col-60">
                <span class="section-heading">Item of Modification &amp; Contents</span>
            </div>
            <div class="col-40"></div>
        </div>
        <div style="margin-bottom:14px;" class="info-panel">
            <div class="row">
                <div class="col-50">
                    <span class="mod-item-title">1.) According to your request MAIL BY MOLD</span>
                </div>
                <div class="col-50 txt-right"></div>
            </div>
            <div class="row" style="margin-top:6px;">
                <div class="col-5"></div>
                <div class="col-90 mod-detail-box">
                    @{
                        var combinedText = Model._ViewceMastModifyRequest.mfDetail + "\n(REQUEST BY: " + Model._ViewceMastModifyRequest.mfIssueDept + ").";
                    }
                    @Html.TextArea("combinedText", combinedText, new
                    {
                        @class = "font-Arial",
                        rows = 8,
                        @readonly = "readonly",
                        style = "border: none; resize: none; background: transparent; width: 100%; font-size:12px; padding: 6px 4px;"
                    })
                </div>
                <div class="col-5"></div>
            </div>
        </div>
        <!-- ===================== Schedule ===================== -->
        <div style="margin-bottom:10px;">
            <span class="schedule-heading">Making schedule</span>
            <div class="row">
                <div class="col-100 center" style="margin-top:16px; margin-bottom:10px;">
                    @if (Model._ViewceMastModifyRequest.mfType != null)
                    {
                        if (Model._ViewceMastModifyRequest.mfType.Contains("CLAIM"))
                        {
                            <span class="schedule-claim">ALREADY</span>
                        }
                        else
                        {
                            <span class="schedule-normal">
                                We use working time modify mold&nbsp;
                                @Html.DisplayFor(model => model._ViewceMastModifyRequest.mfLeadTime)&nbsp;day
                            </span>
                        }
                    }
                </div>
            </div>
            <hr class="section-rule" />
            <div class="row" style="margin-top:14px;">
                <div class="col-100 center">
                    <span class="closing-line">
                        We are looking forward to receiving your kind acceptance, we remain.
                    </span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-80"></div>
            <div class="col-20" style="margin-top:18px; margin-bottom:10px;">
                <span class="signoff">Yours faithfully,</span>
            </div>
        </div>

        <!-- ===================== Signatures ===================== -->
        <div class="row sig-block" style="align-items:flex-end;">
            <div class="col-20"><span class="sig-role">ISSUED BY:</span></div>
            <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.IssueBy)</span></div>
            <div class="col-30 center sig-line">
                @{
                    var empOP = Model._ViewOperaterCP.empIssueBy;
                }
                <img src="~/images/@(empOP).png" style="width:100px;height:20px;" onerror="this.style.display='none';" />
            </div>
        </div>
        <div class="row sig-block" style="align-items:flex-end;">
            <div class="col-20"><span class="sig-role">CHECKED BY:</span></div>
            <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.CheckedByTL)</span></div>
            <div class="col-30 center sig-line">
                @{
                    var empTL = Model._ViewOperaterCP.empCheckedByTL;
                }
                <img src="~/images/@(empTL).png" style="width:100px;height:20px;" onerror="this.style.display='none';" />
            </div>
        </div>
        <div class="row sig-block" style="align-items:flex-end;">
            <div class="col-20"><span class="sig-role">CHECKED BY:</span></div>
            <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.CheckedByTM)</span></div>
            <div class="col-30 center sig-line">
                @{
                    var empTM = Model._ViewOperaterCP.empCheckedByTM;
                }
                <img src="~/images/@(empTM).png" style="width:110px;height:30px;" onerror="this.style.display='none';" />
            </div>
        </div>
        <div class="row sig-block" style="align-items:flex-end;">
            <div class="col-20"><span class="sig-role">APPROVED BY:</span></div>
            <div class="col-50"><span class="sig-name">@Html.DisplayFor(model => model._ViewOperaterCP.ApproveBy)</span></div>
            <div class="col-30 center sig-line">
                @{
                    var empAP = Model._ViewOperaterCP.empApproveBy;
                }
                <img src="~/images/@(empAP).png" style="width:100px;height:30px;" onerror="this.style.display='none';" />
            </div>
        </div>
    </div>
</body>